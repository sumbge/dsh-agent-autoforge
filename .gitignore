# Runtime state and caches, not source.
.data/
*.db
*.db-shm
*.db-wal
schedule.jsonl
runs/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Installed dependencies. The plugin has none of its own, but an `npm install`
# or a `pip install -e .` inside this tree would create them, and a directory
# holding megabytes of someone else's code should never be a first-commit
# surprise.
node_modules/
.venv/
venv/
*.egg-info/
*.egg

# Logs and tool output. Nothing here is generated by the code; it is what the
# code leaves behind when someone runs it.
*.log

*.bak*
*.orig
.DS_Store
Thumbs.db

*.key
*.pem
.env
.env.*
